{
  "name": "@vibefield/rosetta-agent-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "rosetta's agent-view app: the Electron host of the History room, which lives in clients/room as @vibefield/rosetta-room.",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --import ./test/support/resolve-ts.mjs --test test/*.test.mjs",
    "test:ui-motion": "electron test/ui-motion.electron.mjs",
    "test:list-order": "electron test/list-order.electron.mjs",
    "test:transcript-loading": "electron test/transcript-loading.electron.mjs",
    "test:web-search": "electron test/web-search.electron.mjs",
    "test:image-strips": "electron test/image-strips.electron.mjs",
    "test:image-gallery": "electron test/image-gallery.electron.mjs",
    "test:message-preview": "electron test/message-preview.electron.mjs",
    "test:activity-fold": "electron test/activity-fold.electron.mjs",
    "test:history-window": "electron test/history-window.electron.mjs",
    "test:worktree-actions": "electron test/worktree-actions.electron.mjs",
    "test:file-viewer-browsers": "electron test/file-viewer-browsers.electron.mjs",
    "test:activity-chart": "electron test/activity-chart.electron.mjs",
    "test:models-chart": "electron test/models-chart.electron.mjs",
    "test:room-host": "electron test/room-host.electron.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.10",
    "@vibecook/mille": "^0.3.4",
    "@vibecook/mille-ui": "^0.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "@vibefield/rosetta-protocol": "^0.1.1",
    "@vibefield/rosetta-room": "^0.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.13"
  }
}
