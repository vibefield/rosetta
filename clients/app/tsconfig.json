{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    // `lib/transcript/*` carries explicit `.ts` extensions on its relative
    // imports so node's type stripping can run those modules directly under
    // `node --test`. Legal here because nothing is emitted.
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "paths": {
      "@rosetta/protocol": ["../ts/index.ts"]
    }
  },
  "include": ["renderer/src", "vite.config.ts", "../ts/index.ts", "../ts/client.ts", "../ts/generated"]
}
