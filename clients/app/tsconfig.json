{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    // The flags a host that compiles the room's source (VibeField) builds
    // with: the room passes them here so it passes them there.
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    // Relative imports carry no extension, so a consumer's compiler needs no
    // `allowImportingTsExtensions`; `node --test` resolves them through
    // `test/support/resolve-ts.mjs`.
    "useDefineForClassFields": true,
    "paths": {
      "@vibefield/rosetta-protocol": ["../ts/index.ts"],
      "@vibefield/rosetta-room": ["../room/src/index.ts"],
      "@vibefield/rosetta-room/fixtures": ["../room/src/fixtures/index.ts"]
    }
  },
  "include": ["renderer/src", "vite.config.ts", "../ts/index.ts", "../ts/client.ts", "../ts/generated"]
}
