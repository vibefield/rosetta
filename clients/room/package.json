    "@radix-ui/react-tooltip": "^1.2.16",
    "@rosetta/protocol": "link:../ts",
    "@tanstack/react-virtual": "^3.14.10",
    "@vibecook/mille": "link:../../../mille/packages/mille",
    "@vibecook/mille-ui": "link:../../../mille/packages/mille-ui"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3"
  }
