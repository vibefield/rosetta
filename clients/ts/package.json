{
  "name": "@vibefield/rosetta-protocol",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol-version": {
      "types": "./dist/protocol-version.d.mts",
      "import": "./dist/protocol-version.mjs"
    },
    "./grants": {
      "types": "./dist/grants.d.ts",
      "import": "./dist/grants.js"
    }
  },
  "scripts": {
    "build": "node ../../tools/npm/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibefield/rosetta.git",
    "directory": "clients/ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Rosetta protocol types, transport client, subscriptions, and session grants.",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
